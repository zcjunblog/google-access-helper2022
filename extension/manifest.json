{
  "manifest_version": 3,
  "name": "Google Access Helper",
  "version": "1.0.0",
  "description": "代理配置与启停、Google 常用服务入口、按需连接诊断。支持 HTTP、HTTPS、SOCKS5，使用你已有的代理服务。",
  "minimum_chrome_version": "114",
  "permissions": ["proxy", "storage"],
  "optional_host_permissions": [
    "https://www.google.com/*",
    "https://chromewebstore.google.com/*",
    "https://scholar.google.com/*"
  ],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Google Access Helper" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
